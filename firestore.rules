rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Function to check if the user is an admin
    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users Collection: Users can read/write their own document. Admins can read all.
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && request.auth.uid == userId; // Allow creation on signup
      allow update: if isAdmin();
    }

    // Menu Items: Anyone authenticated can read. Only admins can write.
    match /menuItems/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Bookings: Users can read/write their own. Admins can read/write all.
    match /bookings/{bookingId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
    }

    // Waste Logs: Only admins can read and write.
    match /wasteLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Reports: Users can read/write their own. Admins can read/write all.
    match /reports/{reportId} {
      allow read, update: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Sales History: Used for prediction. Admins only for write. Students can read for predictions.
    match /salesHistory/{saleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
